{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": [
      "  ╔═══════════════════════════╗",
      "  ║   ███████ ██   ██  ██████ ║",
      "  ║   ██      ██   ██ ██    ██║",
      "  ║   ███████ ███████ ██    ██║",
      "  ║        ██ ██   ██ ██    ██║",
      "  ║   ███████ ██   ██  ██████ ║",
      "  ╚═══════════════════════════╝",
      "        S H O B I K A O S      "
    ],
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[34m┌──────────────────────────────────┐\u001b[0m"
    },
    {
      "type": "title",
      "format": "  {user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[34m├──────────────────────────────────┤\u001b[0m"
    },
    {
      "type": "os",
      "key": "  OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": "  Packages",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "blue"
    },
    {
      "type": "de",
      "key": "  DE",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "blue"
    },
    {
      "type": "theme",
      "key": "  Theme",
      "keyColor": "blue"
    },
    {
      "type": "icons",
      "key": "  Icons",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "  CPU",
      "keyColor": "cyan",
      "temp": true
    },
    {
      "type": "gpu",
      "key": "  GPU",
      "keyColor": "cyan",
      "temp": true
    },
    {
      "type": "memory",
      "key": "  Memory",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "  Disk (/)",
      "keyColor": "cyan",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "\u001b[34m└──────────────────────────────────┘\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "circle"
    }
  ]
}