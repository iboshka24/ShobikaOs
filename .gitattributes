# Force LF line endings for all shell scripts and text files
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
profiledef.sh text eol=lf

# Binary files
*.iso binary
*.png binary
*.jpg binary
*.gif binary
